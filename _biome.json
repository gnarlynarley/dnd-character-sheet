{
	"$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
	"html": {
		"formatter": {
			"enabled": true
		},
		"experimentalFullSupportEnabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"files": {
		"include": ["src/**/*.ts", "src/**/*.svelte", "src/**/*.js"]
	}
}
